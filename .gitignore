# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production (contents pattern, not the dir itself, so the un-ignore below
# can reach into it — git doesn't descend into ignored directories)
/build/*
# ...except the electron-builder app icon, which lives in build/ by convention
!/build/icon.png

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers
.superpowers/

# local data
data/

# electron desktop build
/dist-electron/
/dist-desktop/

# internal founder docs — never publish
docs/plans/
docs/specs/
